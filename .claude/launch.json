{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-noauth",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:AUTH_MODE='off'; npx next dev -p 3100"],
      "port": 3100
    },
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3000"],
      "port": 3000
    },
    {
      "name": "agent",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "agent"],
      "port": 8000
    }
  ]
}
