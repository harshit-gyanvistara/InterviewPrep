{
  "expo": {
    "name": "Offerly",
    "slug": "offerly",
    "scheme": "offerly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0e0f12",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.offerly.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Offerly uses your camera during mock interviews so you can review your delivery.",
        "NSMicrophoneUsageDescription": "Offerly uses your microphone during mock interviews to transcribe your answers."
      }
    },
    "android": {
      "package": "com.offerly.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-status-bar"]
  }
}
