# Copy to liveAgent/.env and fill in. Never commit .env.

# Gemini (required for any AI feature). The key lives only in this service.
GEMINI_API_KEY=
# Optional model overrides
# GEMINI_CHAT_MODEL=
# GEMINI_SCORING_MODEL=

# Shared secret Core sends as "Authorization: Bearer <token>". Must equal LIVE_AGENT_TOKEN in the
# Next.js app's .env.local. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LIVE_AGENT_TOKEN=
