# Copy to .env.local and fill in. Never commit .env.local.

# liveAgent, the Python AI service (required for any AI feature). The Gemini key lives in
# liveAgent/.env, not here; see liveAgent/.env.example.
LIVE_AGENT_URL=http://localhost:8000
# Must equal LIVE_AGENT_TOKEN in liveAgent/.env.
LIVE_AGENT_TOKEN=

# Supabase. Optional for local work: without URL + publishable key there is no sign-in
# (AUTH_MODE=off) and the catalog comes from lib/domains and lib/packs. Required in production.
# Project URL: Supabase dashboard → Project Settings → Data API
SUPABASE_URL=
# Publishable key (sb_publishable_...): Project Settings → API Keys. Used with each user's session,
# so row-level security applies. Setting it (with the URL) turns accounts on.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): same page. Server-only, bypasses RLS: catalog reads, account deletion.
SUPABASE_SECRET_KEY=

# Accounts (plans/auth.md). AUTH_MODE: "supabase" or "off"; defaults to supabase when the two keys
# above are set. "off" means one local user and is refused in production.
AUTH_MODE=
# "on" shows "Continue with Google" on the web (enable the Google provider in Supabase first).
AUTH_GOOGLE=
# Extra email domains refused at sign-in, comma-separated, on top of the built-in list of
# temporary inboxes (lib/emailPolicy.ts).
BLOCKED_EMAIL_DOMAINS=
# Private beta: only these emails / @domains (comma-separated) can sign in and use AI. Empty = open.
BETA_ALLOWED_EMAILS=
# Super-admins (comma-separated emails): can create organisations and set their plans at /admin/orgs
# (plans/m2-org.md O.1). Needs SUPABASE_SECRET_KEY. Empty = nobody.
SUPER_ADMIN_EMAILS=
# Package everyone is on (lib/packages.ts: beta, free, pro). Defaults to beta.
PACKAGE_DEFAULT=

# Rate limiting (optional). Per-IP limits on the AI routes always apply (lib/rateLimit.ts). Without
# these they are counted in server memory, which is per instance; set them in any multi-instance
# deploy (e.g. Vercel) so all instances share the counts. Upstash console → your Redis → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Reminder emails to students (due-soon, overdue, and staff nudges). Without these nothing is sent.
# RESEND_API_KEY: resend.com → API Keys. MAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=
# The address practice links in emails point at.
APP_URL=
# Secret for the daily reminder run: call GET /api/cron/reminders with "Authorization: Bearer <this>".
# Vercel Cron sends that header itself when CRON_SECRET is set. Generate one: openssl rand -base64 32
CRON_SECRET=

# LOCAL DEVELOPMENT ONLY. DEV_LOGIN=on adds a "Dev sign-in" button that signs in a SUPER_ADMIN_EMAILS address
# without sending an email. It is ignored when NODE_ENV=production. Leave it unset everywhere else.
DEV_LOGIN=
