# Copy to .env.local and fill in. Never commit .env.local.

# liveAgent, the Python AI service (required for any AI feature). The Gemini key lives in
# liveAgent/.env, not here; see liveAgent/.env.example.
LIVE_AGENT_URL=http://localhost:8000
# Must equal LIVE_AGENT_TOKEN in liveAgent/.env.
LIVE_AGENT_TOKEN=

# Supabase (optional: without these the app uses the code defaults in lib/domains and lib/packs)
# Project URL: Supabase dashboard → Project Settings → Data API
SUPABASE_URL=
# Secret key (sb_secret_...): Project Settings → API Keys. Server-only, bypasses RLS.
SUPABASE_SECRET_KEY=
